// Cloudflare Workers config (deployed with OpenNext, see README → Deployment).
// Secrets are NOT set here: add them in the dashboard or with `wrangler secret put`:
//   ECLESIAR_API_KEY, INGEST_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eclesiar-radar",
  // Wraps the OpenNext worker to add the cron handler (see cloudflare-worker.js).
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "eclesiar-radar"
    }
  ],
  // The database. No database_id: the first `wrangler deploy` creates it and
  // binds it automatically. Locally, `pnpm dev` uses a simulated copy in .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eclesiar-radar"
    }
  ],
  // The collector. Sized for the Workers Free plan: at most 50 external
  // subrequests per invocation (D1 queries don't count) and D1's free daily
  // quotas (5M rows read, 100k rows written). 30 API requests every 2 minutes
  // ≈ 21k requests/day, under the API's 50k/day.
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  // Keep variables added in the dashboard when deploying (otherwise each deploy
  // replaces them with the "vars" below). Secrets are always kept.
  "keep_vars": true,
  "vars": {
    // No in-process timer on Workers; the cron above drives collection.
    "AUTO_INGEST_MINUTES": "0",
    "INGEST_BUDGET": "30"
  },
  "observability": {
    "enabled": true
  }
}
