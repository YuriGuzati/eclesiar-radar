# Copy to .env.local and fill in. Everything is optional: with no key the app
# runs in DEMO mode on synthetic data.

# Your Eclesiar API key (log in at https://eclesiar.com/api → "Generate New Key").
# Server-side only; never exposed to the browser.
ECLESIAR_API_KEY=

# Postgres for production (Supabase, Neon…). Without it, an embedded PGlite
# database is stored in ./.data/ (fine for local use / a single server).
DATABASE_URL=

# Bearer token required by /api/ingest when called by an external cron.
INGEST_SECRET=

# In-process collector interval in minutes (0 = off; default 10, off on Vercel).
# AUTO_INGEST_MINUTES=10

# Upstream requests per collector run, and the daily soft cap (the API allows 50,000/day).
# INGEST_BUDGET=180
# DAILY_REQUEST_LIMIT=40000
# INGEST_CONCURRENCY=4
